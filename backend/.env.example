# ==========================================
# SMART LIBRARY ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your values.
# ==========================================

# Database Connection (Supabase PostgreSQL or Local PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres

# JWT Secret & Encryption
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=60

# Gmail SMTP Configuration for Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_library_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
MAIL_FROM=your_library_email@gmail.com
MAIL_FROM_NAME="Smart Library"

# Razorpay Configuration (Test/Live Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_PLAN_AMOUNT_INR=1

# OpenAI API Key (Optional AI drafter)
OPENAI_API_KEY=sk-your-openai-api-key

# Vobiz Voice CPaaS Credentials
VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token
VOBIZ_FROM_NUMBER=+918000000000
VOBIZ_SIP_DOMAIN=your_sip_domain.sip.vobiz.ai

